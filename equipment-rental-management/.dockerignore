.coverage
htmlcov/
test-results/
playwright-report/

# API testing collections, docs, editor and OS files
postman/
*.md
.vscode/
.idea/
.DS_Store

# Secrets, in case any are ever added locally
.env
.env.*
*.pem
*.key

# Docker files themselves
Dockerfile
.dockerignore
